      "seed": 408970232,
      "version": 489,
      "versionNonce": 603203119,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783846808881,
      "link": null,
      "locked": false,
      "text": "그리고 본인이 코드를 볼 줄 모른다면, 그 코드의 퀄리티는 점점 산으로 가게 될겁니다.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "그리고 본인이 코드를 볼 줄 모른다면, 그 코드의 퀄리티는 점점 산으로 가게 될겁니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "CrSyx8NGRewBHQCV9a7dm",
      "type": "text",
      "x": 1119.7289914468545,
      "y": -321.74082083934354,
      "width": 509.82831404745303,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 2032941960,
      "version": 391,
      "versionNonce": 1255115969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783846508213,
      "link": null,
      "locked": false,
      "text": "그럼 오픈소스 하네스들도 다 의미 없는거냐?\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "그럼 오픈소스 하네스들도 다 의미 없는거냐?\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "iFgLE7BhjM-h9yH1ddPOG",
      "type": "text",
      "x": 1251.0166449768603,
      "y": -282.7970990476035,
      "width": 123.15995788574219,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1120135304,
      "version": 256,
      "versionNonce": 362957985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783846508213,
      "link": null,
      "locked": false,
      "text": "그건 아닙니다.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "그건 아닙니다.",
